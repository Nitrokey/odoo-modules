<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_icon_view_form" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <form string="Product icon">
                <sheet>
                    <field name="product_template_id" invisible="True" />
                    <div class="oe_left" style="width: 500px;">
                        <field
                            name="image_1920"
                            widget="image"
                            class="oe_avatar oe_left"
                        />
                        <div class="oe_title" style="width: 390px;">
                            <label
                                class="oe_edit_only"
                                for="name"
                                string="Image name"
                            />
                            <h2>
                                <field name="name" class="oe_inline" />
                            </h2>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="sequence" widget="handle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_icon_view_tree" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <list string="Product icons">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="product_icon_view_kanban" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <field name="name" />
                <field name="image_128" />
                <field name="sequence" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img
                                    t-att-src="kanban_image('product.icon', 'image_128', record.id.raw_value)"
                                    t-att-alt="record.name.value"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <h4>
                                    <a type="open">
                                        <field name="name" />
                                    </a>
                                </h4>
                                <span
                                    t-attf-class="o_website_sale_image_card_size badge badge-#{size_status}"
                                    t-att-title="message"
                                >
                                    <t t-esc="record.image_128.value" />
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_icon_action" model="ir.actions.act_window">
        <field name="name">Product Icons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.icon</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        id="product_icon_menu"
        name="Product icons"
        parent="sale.prod_config_main"
        action="product_icon_action"
        sequence="29"
    />
</odoo>
