<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_carrier_account_form_inherit_dhl" model="ir.ui.view">
        <field name="name">carrier.account.form.inherit.dhl</field>
        <field name="model">carrier.account</field>
        <field
            name="inherit_id"
            ref="delivery_carrier_account.carrier_account_view_form"
        />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="use_dhl_parcel_de_shipping_provider" />
                <field
                    name="dhl_parcel_de_api_url"
                    required="use_dhl_parcel_de_shipping_provider == True"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_userid"
                    required="use_dhl_parcel_de_shipping_provider == True"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_password"
                    password="True"
                    required="use_dhl_parcel_de_shipping_provider == True"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_api_key"
                    password="True"
                    required="use_dhl_parcel_de_shipping_provider == True"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_api_secret"
                    password="True"
                    required="use_dhl_parcel_de_shipping_provider != False"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_tracking_url"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <button
                    name="dhl_parcel_de_get_access_token"
                    type="object"
                    string="Generate Authentication Token"
                    class="fa fa-arrow-right oe_link"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
                <field
                    name="dhl_access_token"
                    invisible="use_dhl_parcel_de_shipping_provider != True"
                />
            </field>
        </field>
    </record>
</odoo>
