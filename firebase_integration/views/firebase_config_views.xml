<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Firebase Configuration Form View -->
    <record id="view_firebase_config_form" model="ir.ui.view">
        <field name="name">firebase.config.form</field>
        <field name="model">firebase.config</field>
        <field name="arch" type="xml">
            <form string="Firebase Configuration">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="is_active" />
                    </group>
                    <group string="Server-side Configuration">
                        <field name="private_key_filename" invisible="1" />
                        <field
                            name="private_key_file"
                            filename="private_key_filename"
                        />
                    </group>
                    <group string="Web App Configuration (for Browser Notifications)">
                        <field name="web_api_key" />
                        <field name="web_auth_domain" />
                        <field name="web_project_id" />
                        <field name="web_storage_bucket" />
                        <field name="web_messaging_sender_id" />
                        <field name="web_app_id" />
                        <field name="vapid_key" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Firebase Configuration Tree View -->
    <record id="view_firebase_config_tree" model="ir.ui.view">
        <field name="name">firebase.config.tree</field>
        <field name="model">firebase.config</field>
        <field name="arch" type="xml">
            <tree string="Firebase Configurations">
                <field name="name" />
                <field name="is_active" />
                <field name="private_key_filename" />
            </tree>
        </field>
    </record>

    <!-- Firebase Configuration Action -->
    <record id="action_firebase_config" model="ir.actions.act_window">
        <field name="name">Firebase Configuration</field>
        <field name="res_model">firebase.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Firebase configuration!
            </p>
            <p>
                Upload your Firebase service account private key JSON file to enable Firebase integration.
            </p>
        </field>
    </record>

    <!-- Firebase Configuration Menu -->
    <menuitem
        id="menu_firebase_config"
        name="Firebase Configuration"
        parent="base.menu_administration"
        action="action_firebase_config"
        groups="base.group_system"
        sequence="100"
    />

    <!-- Settings View -->
    <record id="res_config_settings_view_form_firebase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.firebase</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Firebase Integration"
                    string="Firebase Integration"
                    data-key="firebase_integration"
                >
                    <h2>Firebase Integration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="firebase_is_active" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label
                                    for="firebase_is_active"
                                >Enable Firebase Integration</label>
                                <div class="text-muted">
                                    Enable Firebase push notifications and integration features
                                </div>
                            </div>
                        </div>
                        <div
                            class="col-12 col-lg-6 o_setting_box"
                            attrs="{'invisible': [('firebase_is_active', '=', False)]}"
                        >
                            <div class="o_setting_right_pane">
                                <label
                                    for="firebase_private_key_file"
                                >Firebase Private Key File</label>
                                <div class="text-muted">
                                    Upload the Firebase service account private key JSON file
                                </div>
                                <field
                                    name="firebase_private_key_file"
                                    filename="firebase_private_key_filename"
                                />
                                <field
                                    name="firebase_private_key_filename"
                                    invisible="1"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('firebase_is_active', '=', False)]}">
                        <div class="col-12">
                            <h3>Web App Configuration (for Browser Notifications)</h3>
                            <div class="text-muted mb16">
                                Configure Firebase web app settings for browser push notifications. Get these values from your Firebase Console > Project Settings > General > Your apps > Web app.
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_api_key">Web API Key</label>
                                <field name="firebase_web_api_key" placeholder="AIzaSyC..." />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_auth_domain">Auth Domain</label>
                                <field name="firebase_web_auth_domain" placeholder="my-project.firebaseapp.com" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_project_id">Project ID</label>
                                <field name="firebase_web_project_id" placeholder="my-project" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_storage_bucket">Storage Bucket</label>
                                <field name="firebase_web_storage_bucket" placeholder="my-project.appspot.com" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_messaging_sender_id">Messaging Sender ID</label>
                                <field name="firebase_web_messaging_sender_id" placeholder="123456789" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_web_app_id">App ID</label>
                                <field name="firebase_web_app_id" placeholder="1:123456789:web:abc123" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_vapid_key">VAPID Key</label>
                                <div class="text-muted">
                                    Generate this in Firebase Console > Cloud Messaging > Web Push certificates
                                </div>
                                <field name="firebase_vapid_key" placeholder="B..." />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
                                    invisible="1"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
