<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Firebase Configuration Form View -->
    <record id="view_firebase_config_form" model="ir.ui.view">
        <field name="name">firebase.config.form</field>
        <field name="model">firebase.config</field>
        <field name="arch" type="xml">
            <form string="Firebase Configuration">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="is_active" />
                    </group>
                    <group string="Firebase Credentials">
                        <field name="private_key_filename" invisible="1" />
                        <field
                            name="private_key_file"
                            filename="private_key_filename"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Firebase Configuration Tree View -->
    <record id="view_firebase_config_tree" model="ir.ui.view">
        <field name="name">firebase.config.tree</field>
        <field name="model">firebase.config</field>
        <field name="arch" type="xml">
            <tree string="Firebase Configurations">
                <field name="name" />
                <field name="is_active" />
                <field name="private_key_filename" />
            </tree>
        </field>
    </record>

    <!-- Firebase Configuration Action -->
    <record id="action_firebase_config" model="ir.actions.act_window">
        <field name="name">Firebase Configuration</field>
        <field name="res_model">firebase.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Firebase configuration!
            </p>
            <p>
                Upload your Firebase service account private key JSON file to enable Firebase integration.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_firebase_config"
        name="Firebase Configuration"
        parent="base.menu_administration"
        action="action_firebase_config"
        sequence="100"
    />

    <!-- Settings View -->
    <record id="res_config_settings_view_form_firebase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.firebase</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Firebase Integration"
                    string="Firebase Integration"
                    data-key="firebase_integration"
                >
                    <h2>Firebase Integration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="firebase_private_key_file">Firebase Private Key File</label>
                                <div class="text-muted">
                                    Upload the Firebase service account private key JSON file
                                </div>
                                <field
                                    name="firebase_private_key_file"
                                    filename="firebase_private_key_filename"
                                />
                                <field
                                    name="firebase_private_key_filename"
                                    invisible="1"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
