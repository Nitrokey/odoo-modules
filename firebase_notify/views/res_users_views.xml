<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend User Form View to add Firebase notification settings -->
    <record id="view_users_form_firebase" model="ir.ui.view">
        <field name="name">res.users.form.firebase</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Firebase Notifications" name="firebase_notifications">
                    <field name="firebase_notifications_enabled" />
                    <div
                        attrs="{'invisible': [('firebase_notifications_enabled', '=', False)]}"
                    >
                        <div class="firebase_notify_widget_container">
                            <!-- Automatic browser registration widget will be inserted here -->
                        </div>
                        <div class="mt-3">
                            <strong>Manual Token Entry (Advanced)</strong>
                            <p
                                class="text-muted"
                            >If automatic registration doesn't work, you can manually enter your Firebase token:</p>
                            <field
                                name="firebase_token"
                                placeholder="Paste your Firebase device token here (optional)"
                            />
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend User Preferences Form View -->
    <record id="view_users_form_simple_modif_firebase" model="ir.ui.view">
        <field name="name">res.users.preferences.form.firebase</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group string="Firebase Notifications" name="firebase_notifications">
                    <field name="firebase_notifications_enabled" />
                    <div
                        attrs="{'invisible': [('firebase_notifications_enabled', '=', False)]}"
                    >
                        <div class="firebase_notify_widget_container">
                            <!-- Automatic browser registration widget will be inserted here -->
                        </div>
                        <div class="mt-3">
                            <strong>Manual Token Entry (Advanced)</strong>
                            <p
                                class="text-muted"
                            >If automatic registration doesn't work, you can manually enter your Firebase token:</p>
                            <field
                                name="firebase_token"
                                placeholder="Paste your Firebase device token here (optional)"
                            />
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
