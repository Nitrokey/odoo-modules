<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend User Form View to add Firebase notification settings -->
    <record id="view_users_form_firebase" model="ir.ui.view">
        <field name="name">res.users.form.firebase</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Firebase Notifications" name="firebase_notifications">
                    <field name="firebase_notifications_enabled" />
                    <div
                        attrs="{'invisible': [('firebase_notifications_enabled', '=', False)]}"
                    >
                        <div class="alert alert-info" role="status">
                            <strong>🔔 Browser Notifications</strong>
                            <p>Click the button below to enable Firebase notifications in your browser:</p>
                            <button type="button" name="enable_firebase_notifications" class="btn btn-primary" onclick="enableFirebaseNotifications()">
                                <i class="fa fa-bell"/> Enable Browser Notifications
                            </button>
                            <button type="button" name="test_firebase_notification" class="btn btn-success ml-2" onclick="testFirebaseNotification()">
                                <i class="fa fa-paper-plane"/> Test Notification
                            </button>
                        </div>
                        
                        <div class="mt-3">
                            <strong>Current Token Status:</strong>
                            <field name="firebase_token" readonly="1"/>
                            <small class="form-text text-muted">
                                This shows your current Firebase token (auto-generated test token or real browser token)
                            </small>
                        </div>
                        
                        <div class="mt-3">
                            <strong>Manual Token Entry (Advanced)</strong>
                            <p class="text-muted">For mobile apps or manual token entry:</p>
                            <field name="firebase_token" nolabel="1" placeholder="Enter Firebase token manually (optional)"/>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend User Preferences Form View -->
    <record id="view_users_form_simple_modif_firebase" model="ir.ui.view">
        <field name="name">res.users.preferences.form.firebase</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group string="Firebase Notifications" name="firebase_notifications">
                    <field name="firebase_notifications_enabled" />
                    <div
                        attrs="{'invisible': [('firebase_notifications_enabled', '=', False)]}"
                    >
                        <div class="alert alert-info" role="status">
                            <strong>🔔 Browser Notifications</strong>
                            <p>Click the button below to enable Firebase notifications in your browser:</p>
                            <button type="button" name="enable_firebase_notifications_pref" class="btn btn-primary" onclick="enableFirebaseNotifications()">
                                <i class="fa fa-bell"/> Enable Browser Notifications
                            </button>
                            <button type="button" name="test_firebase_notification_pref" class="btn btn-success ml-2" onclick="testFirebaseNotification()">
                                <i class="fa fa-paper-plane"/> Test Notification
                            </button>
                        </div>
                        
                        <div class="mt-3">
                            <strong>Current Token Status:</strong>
                            <field name="firebase_token" readonly="1"/>
                            <small class="form-text text-muted">
                                This shows your current Firebase token (auto-generated test token or real browser token)
                            </small>
                        </div>
                        
                        <div class="mt-3">
                            <strong>Manual Token Entry (Advanced)</strong>
                            <p class="text-muted">For mobile apps or manual token entry:</p>
                            <field name="firebase_token" nolabel="1" placeholder="Enter Firebase token manually (optional)"/>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
