<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="payment_bitcoin_acquirer_form" model="ir.ui.view">
        <field name="name">payment.bitcoin.acquirer.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_config" position="inside">
                <group invisible="code != 'bitcoin'">
                    <field name="deadline" string="Deadline (in minutes)" />
                    <field name="bitcoin_send_email" />
                    <field
                        name="bitcoin_order_older_than"
                        string="Orders older than (In hours)"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
