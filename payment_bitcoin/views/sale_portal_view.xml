<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="sale_order_portal_content_bitcoin_qr"
        name="Portal sale oredr Bitcoin payment QR code"
        inherit_id="sale.sale_order_portal_content"
    >
        <xpath expr="//div[@id='informations']" position="before">
            <t
                t-if="sale_order.get_portal_last_transaction().provider_code == 'Bitcoin' and sale_order.get_portal_last_transaction().duration > 0"
            >
                <span
                    class="total_duration_seconds d-none"
                    t-out="sale_order.get_portal_last_transaction().duration"
                />
            </t>
        </xpath>
    </template>

    <template id="transaction_status_payment_bitcoin" inherit_id="payment.state_header">
        <xpath expr="//div[@name='o_payment_status_alert']" position="after">
            <t t-if="tx.provider_id.sudo().code == 'bitcoin'">
                <div class="panel-body mb-4">
                    <h4>
                        <div class="panel-body">
                            <h4>
                                <strong t-out="info" />
                            </h4>
                        </div>
                    </h4>
                </div>

                <div
                    class="panel-body d-flex justify-content-center align-items-center mb-4"
                >
                    <div class="px-4">
                        <img
                            class="bitcoin_barcode"
                            t-att-src="'/report/barcode/bitcoin/?br_type=QR&amp;value=%s&amp;width=300&amp;height=300' % uri"
                        />
                    </div>
                    <div t-if="tx.duration > 0">
                        <div class="flex-row ml-4" id="countdown_element">
                            <div>
                                <strong>Pay Within:</strong>
                            </div>
                            <div id="timecounter" class="btn btn-info cols-xs-6">
                                <span
                                    class="total_duration_seconds d-none"
                                    t-out="tx.duration"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
