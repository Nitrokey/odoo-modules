<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="server_action_bitcoin_address_goes_low_notification"
        model="ir.actions.server"
    >
        <field name="name">Send bitcoin address goes low notification</field>
        <field name="model_id" ref="payment_bitcoin.model_bitcoin_address" />
        <field name="state">code</field>
        <field name="code">model.send_bitcoin_address_goes_low_notification()</field>
    </record>
    <record
        id="rule_on_create_update_bitcoin_address_goes_low_notification"
        model="base.automation"
    >
        <field name="name">Send bitcoin address goes low notification</field>
        <field name="model_id" ref="payment_bitcoin.model_bitcoin_address" />
        <field name="trigger">on_create_or_write</field>
        <field
            name="action_server_ids"
            eval="[(4, ref('payment_bitcoin.server_action_bitcoin_address_goes_low_notification'))]"
        />
    </record>
</odoo>
