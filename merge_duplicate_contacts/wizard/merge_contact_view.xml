<?xml version="1.0" ?>
<odoo>
    <!-- Disable binding for base partner merge action -->
    <record id="base.action_partner_merge" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False" />
    </record>

    <!-- Add new "Merge Contacts" contextual action -->
    <record id="action_contact_partner_merge" model="ir.actions.server">
        <field name="name">Merge Contacts</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.open_wizard_action()</field>
    </record>

    <!-- Manual merge wizard form -->
    <record id="merge_partner_manual_check_form" model="ir.ui.view">
        <field name="name">merge.partner.manual.check.form</field>
        <field name="model">merge.partner.manual.check</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div style="text-align: center;">
                        <h3>
                            <label
                                for="duplicate_position"
                                string="Duplicates"
                                class="o_form_label"
                            />
                            <field
                                name="duplicate_position"
                                class="oe_inline"
                                readonly="1"
                                style="padding: 0 !important;"
                            />
                            <label
                                for="total_duplicates"
                                string="of"
                                class="oe_inline o_form_label"
                                style="padding-left: 5px;"
                            />
                            <field
                                name="total_duplicates"
                                class="oe_inline"
                                readonly="1"
                                style="padding: 0 !important;"
                            />
                        </h3>
                    </div>
                    <field name="state" invisible="1" />
                    <field name="number_group" invisible="1" />
                    <field name="partner_ids" invisible='1' />
                    <field
                        name="dst_partner_id"
                        domain="[('id', 'in', partner_ids or False)]"
                        required="state == 'selection'"
                        invisible="1"
                    />
                    <field name='contact_type' invisible="1" />
                    <field name='contact_type2' invisible="1" />

                    <div class="row align-items-center mb-2">
                        <div class="col-2">
                            <label
                                colspan="1"
                                for="partner_id_1"
                                string="ID"
                                style="min-width: 108px;"
                            />
                        </div>
                        <div class="col-5">
                            <field
                                colspan="5"
                                name="partner_id_1"
                                nolabel="1"
                                domain="[('id', '=', partner_id_1 or False)]"
                                context="{'only_show_customer_id': True}"
                                options="{'no_create_edit': True, 'no_create': True}"
                            />
                        </div>
                        <div class="col-5">
                            <field
                                colspan="5"
                                name="partner_id_2"
                                nolabel="1"
                                domain="[('id', '=', partner_id_2 or False)]"
                                context="{'only_show_customer_id': True}"
                                options="{'no_create_edit': True, 'no_create': True}"
                            />
                        </div>
                    </div>

                    <group col="13" invisible="1">
                        <label colspan="1" for="id1" style="min-width: 108px;" />
