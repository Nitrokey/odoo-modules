                                invisible="not country_show_icon"
                            />
                            <button
                                name="swap_to_right"
                                type="object"
                                title="right"
                                class="fa fa-arrow-right oe_inline"
                                context="{'field_name':'country_id'}"
                            />
                        </div>
                        <div class="col-3">
                            <field
                                name="country_id2"
                                nolabel="1"
                                class="oe_inline"
                                readonly="contact_type2 == 'contact' and company_id2"
                            />
                        </div>
                    </div>

                    <div class="row align-items-center mb-2">
                        <div class="col-2">
                            <label for="vat_1" style="min-width: 108px;" />
                        </div>
                        <div class="col-3">
                            <field
                                name="vat_1"
                                nolabel="1"
                                class="oe_inline"
                                readonly="contact_type == 'contact' and company_id"
                            />
                            <field
                                name='vat_show_icon'
                                invisible="1"
                                class="oe_inline"
                            />
                        </div>
                        <div class="col-3">
                            <button
                                name="swap_to_left"
                                type="object"
                                title="left"
                                class="fa fa-arrow-left oe_inline"
                                context="{'field_name':'vat_2'}"
                            />
                            <button
                                name="dummy_button"
                                string="Differ"
                                type="object"
                                class="btn-danger oe_inline"
                                invisible="vat_show_icon"
                            />
                            <button
                                name="dummy_button"
                                string="Same"
                                type="object"
                                class="oe_inline"
                                invisible="not vat_show_icon"
                            />
                            <button
                                name="swap_to_right"
                                type="object"
                                title="right"
                                class="fa fa-arrow-right oe_inline"
                                context="{'field_name':'vat_1'}"
                            />
                        </div>
                        <div class="col-3">
                            <field
                                name="vat_2"
                                nolabel="1"
                                class="oe_inline"
                                readonly="contact_type2 == 'contact' and company_id2"
                            />
                        </div>
                    </div>

                    <div class="row align-items-center mb-2">
                        <div class="col-2">
                            <label for="is_company" style="min-width: 108px;" />
                        </div>
                        <div class="col-3">
                            <field
                                name="is_company"
                                nolabel="1"
                                class="oe_inline"
                                style="min-width: 295px;"
                            />
                            <field
                                name='is_company_show_icon'
                                invisible="1"
                                class="oe_inline"
                            />
                        </div>
                        <div class="col-3">
                            <button
                                name="swap_to_left"
                                type="object"
                                title="left"
                                class="fa fa-arrow-left oe_inline"
                                context="{'field_name':'is_company2'}"
                            />

                            <button
                                name="dummy_button"
                                string="Differ"
                                type="object"
                                class="btn-danger oe_inline"
                                invisible="is_company_show_icon"
                            />
                            <button
                                name="dummy_button"
                                string="Same"
                                type="object"
                                class="oe_inline"
                                invisible="not is_company_show_icon"
                            />

                            <button
                                name="swap_to_right"
                                type="object"
                                title="right"
                                class="fa fa-arrow-right oe_inline"
                                context="{'field_name':'is_company'}"
                            />
                        </div>
                        <div class="col-3">
                            <field
                                name="is_company2"
                                nolabel="1"
                                class="oe_inline"
                                style="min-width: 200px;"
                            />
                        </div>
                    </div>

                    <div class="row align-items-center mb-2">
                        <div class="col-2">
                            <label colspan="1" for="keep1" style="min-width: 108px;" />
                        </div>
                        <div class="col-3">
                            <field colspan="5" name="keep1" nolabel="1" />
                        </div>
                        <div class="col-3">
                            <button
                                colspan="1"
                                name="swap_to_left"
                                type="object"
                                title="left"
                                class="fa fa-arrow-left"
                                style="display:none;"
                                context="{'field_name': 'company_id2', 'field_name2': 'company_id'}"
                            />
                            <button
                                colspan="1"
                                name="swap_to_right"
                                type="object"
                                title="right"
                                class="fa fa-arrow-right"
                                style="display:none;"
                                context="{'field_name': 'company_id', 'field_name2': 'company_id2'}"
                            />
                        </div>
                        <div class="col-3">
                            <field colspan="4" name="keep2" nolabel="1" />
                        </div>
                    </div>
                </sheet>
                <footer>
                    <center>
                        <button
                            class="btn btn-secondary oe_inline mx-2"
                            name="action_merge"
                            string="Merge"
                            type="object"
                            style="margin-right:100px;"
                        />
                        <button
                            class="btn btn-secondary oe_inline mx-2"
                            name="action_skip"
                            string="Skip"
                            type="object"
                            style="margin-right:100px;"
                        />
                        <button
                            special="cancel"
                            string="Cancel"
                            type="object"
                            class="btn btn-secondary oe_inline mx-2"
                            style="margin-right:100px;"
                        />
                    </center>
                </footer>
            </form>
        </field>
    </record>

    <!-- Extension of automatic merge wizard -->
    <record id="merge_partner_manual_check_form_ext" model="ir.ui.view">
        <field name="name">base.partner.merge.automatic.wizard</field>
        <field name="model">base.partner.merge.automatic.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.base_partner_merge_automatic_wizard_form" />
        <field name="arch" type="xml">
            <field name="exclude_contact" position="after">
                <field name="associate_contact" />
                <field name="contact_not_being_customer" />
                <field name="without_sales_orders" />
                <field name="filter_domain_email" />
            </field>
            <field name="group_by_parent_id" />
            <field name="group_by_name" position="after">
                <field name="group_by_phone" />
                <field name="group_by_mobile" />
            </field>
        </field>
    </record>
</odoo>
