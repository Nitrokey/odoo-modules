#. module: website_mass_mailing_double_opt_in_nitrokey
#: model:mail.template,body_html:website_mass_mailing_double_opt_in_nitrokey.nitrokey_newsletter_confirmation_request_template
msgid ""
"<div style=\"margin: -10px -10px; padding:50px 30px 50px 30px; height:100%;\">\n"
"                <div style=\"margin:0 auto; max-width:660px;\">\n"
"                    <div style=\"float: left; background-color: #FFFFFF; padding:10px 30px 10px 30px; border: 1px solid #DDDDDD;\">\n"
"                        <div style=\"float: left; max-width:470px;\">\n"
"                            <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">\n"
"                                <strong style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 18px;\">Confirm your newsletter subscription\n"
"                                </strong>\n"
"                            </p>\n"
"                            <div style=\"line-height: 21px; min-height: 100px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Thanks for subscribing to our email list.\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">You allow Nitrokey to be in touch with you via email for the purpose of news, updates\n"
"                                    and product information. If you wish to withdraw your consent and stop hearing from\n"
"                                    us, simply click the unsubscribe link at the bottom of every email. By subscribing,\n"
"                                    you agree that we may process your information in accordance with our <a href=\"https://www.nitrokey.com/data-privacy-policy\">policy</a>.\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Please confirm your subscription by clicking the button below:\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px; margin-bottom: 25px; padding: 15px; text-align: center;\">\n"
"                                    <a t-attf-href=\"/newsletter/confirmation/{{ object.access_token }}\" style=\"background-color: #449d44; padding: 12px; font-weight: 12px; text-decoration: none; color: #fff; border-radius: 5px; font-size:16px;\">Confirm\n"
"                                    </a>\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Thank you,<br/>Nitrokey\n"
"                                </p>\n"
"                            </div>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div style=\"max-width: 532px; background-color: #14212D;\">\n"
"                        <table style=\"margin-left: 15px;\">\n"
"                            <tr>\n"
"                                <td class=\"text\" colspan=\"2\" style=\"color: #FFFFFF;font-family: Arial;font-size: 13px;letter-spacing: 0;line-height: 17px;\">\n"
"                                    <br/>\n"
"                                    <strong t-out=\"user.company_id.name\"/>\n"
"                                    <br/>\n"
"\n"
"                                    <t t-if=\"user.company_id.street\">\n"
"                                        <t t-out=\"user.company_id.street\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.street2\">\n"
"                                        <t t-out=\"user.company_id.street2\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.city or user.company_id.zip\">\n"
"                                        <t t-out=\"user.company_id.zip\"/>\n"
"                                        <t t-out=\"user.company_id.city\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.country_id\">\n"
"                                        <t t-out=\"user.company_id.state_id.name or ''\"/>\n"
"                                        <t t-out=\"user.company_id.country_id.name or ''\"/>\n"
"                                    </t>\n"
"                                    <br/>\n"
"                                    <br/>\n"
"                                    <strong>CEO:</strong>\n"
"                                    <t t-out=\"user.company_id.ceo or ''\"/>\n"
"                                    <br/>\n"
"                                    <strong>Company register:</strong>\n"
"                                    <t t-out=\"user.company_id.company_registry or ''\"/>\n"
"                                    <br/>\n"
"                                    <strong>VAT ID:</strong>\n"
"                                    <t t-out=\"user.company_id.vat or ''\"/>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: -10px -10px; padding:50px 30px 50px 30px; height:100%;\">\n"
"                <div style=\"margin:0 auto; max-width:660px;\">\n"
"                    <div style=\"float: left; background-color: #FFFFFF; padding:10px 30px 10px 30px; border: 1px solid #DDDDDD;\">\n"
"                        <div style=\"float: left; max-width:470px;\">\n"
"                            <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">\n"
"                                <strong style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 18px;\">Bestätigen Sie Ihr Newsletter Abonnement.\n"
"                                </strong>\n"
"                            </p>\n"
"                            <div style=\"line-height: 21px; min-height: 100px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Danke, dass Sie sich in unsere E-Mail-Liste eingetragen haben.\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Sie erlauben Nitrokey, sich per E-Mail mit Ihnen in Verbindung zu setzen, um Neuigkeiten, Updates und Produktinformationen zu erhalten. Wenn Sie Ihre Einwilligung widerrufen und nicht mehr von uns hören möchten, klicken Sie einfach auf den Link zum Abbestellen unten in jeder E-Mail. Mit Ihrem Abonnement erklären Sie sich damit einverstanden, dass wir Ihre Daten gemäß  Übereinstimmung mit unserer  <a href=\"https://www.nitrokey.com/data-privacy-policy\">Datenschutzrichtlinie</a>.\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Bitte bestätigen Sie Ihr Abonnement, indem Sie auf die Schaltfläche unten klicken:\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px; margin-bottom: 25px; padding: 15px; text-align: center;\">\n"
"                                    <a t-attf-href=\"/newsletter/confirmation/{{ object.access_token }}\" style=\"background-color: #449d44; padding: 12px; font-weight: 12px; text-decoration: none; color: #fff; border-radius: 5px; font-size:16px;\">Bestätigen\n"
"                                    </a>\n"
"                                </p>\n"
"                                <p style=\"line-height: 21px; font-family: Helvetica, Verdana, Arial, sans-serif; font-size: 12px;\">Vielen Dank,<br/>Nitrokey\n"
"                                </p>\n"
"                            </div>\n"
"                        </div>\n"
"                    </div>\n"
"                    <div style=\"max-width: 532px; background-color: #14212D;\">\n"
"                        <table style=\"margin-left: 15px;\">\n"
"                            <tr>\n"
"                                <td class=\"text\" colspan=\"2\" style=\"color: #FFFFFF;font-family: Arial;font-size: 13px;letter-spacing: 0;line-height: 17px;\">\n"
"                                    <br/>\n"
"                                    <strong t-out=\"user.company_id.name\"/>\n"
"                                    <br/>\n"
"\n"
"                                    <t t-if=\"user.company_id.street\">\n"
"                                        <t t-out=\"user.company_id.street\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.street2\">\n"
"                                        <t t-out=\"user.company_id.street2\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.city or user.company_id.zip\">\n"
"                                        <t t-out=\"user.company_id.zip\"/>\n"
"                                        <t t-out=\"user.company_id.city\"/>,\n"
"                                    </t>\n"
"                                    <t t-if=\"user.company_id.country_id\">\n"
"                                        <t t-out=\"user.company_id.state_id.name or ''\"/>\n"
"                                        <t t-out=\"user.company_id.country_id.name or ''\"/>\n"
"                                    </t>\n"
"                                    <br/>\n"
"                                    <br/>\n"
"                                    <strong>CEO:</strong>\n"
"                                    <t t-out=\"user.company_id.ceo or ''\"/>\n"
"                                    <br/>\n"
"                                    <strong>Company register:</strong>\n"
"                                    <t t-out=\"user.company_id.company_registry or ''\"/>\n"
"                                    <br/>\n"
"                                    <strong>VAT ID:</strong>\n"
"                                    <t t-out=\"user.company_id.vat or ''\"/>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"                </div>\n"
"            </div>\n"
"        "

